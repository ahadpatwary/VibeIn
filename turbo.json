{
   "$schema": "https://turbo.build/schema.json",
   "globalDependencies": ["tsconfig.base.json", ".eslintrc.js", ".prettierrc", "package-lock.json"],
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
      },
      "typecheck": {
         "dependsOn": ["^build"],
         "outputs": []
      },
      "test": {
         "dependsOn": ["^build"],
         "outputs": ["coverage/**"]
      },
      "lint": {
         "outputs": []
      }
   }
}
