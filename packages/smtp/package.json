{
   "name": "@app/email",
   "version": "0.1.0",
   "description": "Type-safe resend wrapper with custom domain methods",
   "private": true,
   "type": "module",
   "main": "./dist/index.js",
   "module": "./dist/index.mjs",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.mjs",
         "require": "./dist/index.js"
      }
   },
   "files": [
      "dist"
   ],
   "sideEffects": false,
   "scripts": {
      "build": "tsup",
      "dev": "tsup --watch",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "typecheck": "tsc --noEmit",
      "clean": "rimraf dist",
      "prepublishOnly": "npm run clean && npm run build"
   },
   "peerDependencies": {},
   "dependencies": {
      "@app/logger": "^1.0.0",
      "resend": "^6.22.1",
      "reflect-metadata": "^0.2.2",
      "tsyringe": "^4.10.0",
      "zod": "^4.4.3"
   },
   "devDependencies": {
      "@app/eslint-config": "*",
      "@types/node": "^24.0.0",
      "tsup": "^8.0.0",
      "typescript": "^5.9.0"
   },
   "keywords": [
      "resend",
      "typescript"
   ],
   "license": "MIT"
}
