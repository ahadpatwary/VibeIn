{
   "name": "@app/otp",
   "version": "1.0.0",
   "private": true,
   "type": "module",
   "description": "Production-grade, class-based otp service with tsyringe DI",
   "main": "./dist/index.js",
   "module": "./dist/index.mjs",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.mjs",
         "require": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "tsup && copyfiles -u 1 \"src/**/*.lua\" dist",
      "dev": "tsup --watch",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "typecheck": "tsc --noEmit",
      "clean": "rimraf dist",
      "prepublishOnly": "npm run clean && npm run build"
   },
   "dependencies": {
      "@app/email": "^0.1.0",
      "@app/eslint-config": "*",
      "@app/logger": "^1.0.0",
      "@app/rate-limiter": "^0.1.0",
      "@app/redis-client": "^0.1.0",
      "bcrypt": "^6.0.0",
      "reflect-metadata": "^0.2.2",
      "tsyringe": "^4.8.0",
      "uuid": "^14.0.2",
      "zod": "^4.4.3"
   },
   "peerDependencies": {},
   "devDependencies": {
      "@types/bcrypt": "^6.0.0",
      "@types/node": "^22.10.7",
      "typescript": "^5.7.3"
   }
}
