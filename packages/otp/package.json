{
   "name": "@app/otp",
   "description": "Production-grade, class-based otp service with tsyringe DI",
   "version": "1.0.0",
   "dependencies": {
      "@app/email": "0.1.0",
      "@app/eslint-config": "1.0.0",
      "@app/logger": "1.0.0",
      "@app/rate-limiter": "0.1.0",
      "@app/redis-client": "0.1.0",
      "bcrypt": "^6.0.0",
      "reflect-metadata": "^0.2.2",
      "tsyringe": "^4.10.0",
      "uuid": "^14.0.2",
      "zod": "^4.6.4"
   },
   "devDependencies": {
      "@types/bcrypt": "^6.0.0",
      "@types/node": "^24.0.0",
      "typescript": "^5.9.0"
   },
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js",
         "require": "./dist/index.cjs"
      }
   },
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "peerDependencies": {},
   "private": true,
   "scripts": {
      "build": "tsup && copyfiles -u 1 \"src/**/*.lua\" dist",
      "dev": "tsup --watch",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "typecheck": "tsc --noEmit",
      "clean": "rimraf dist",
      "prepublishOnly": "npm run clean && npm run build"
   },
   "type": "module",
   "types": "./dist/index.d.ts"
}
