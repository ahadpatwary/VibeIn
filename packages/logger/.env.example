SERVICE_NAME=orderbari-api
NODE_ENV=production
APP_VERSION=1.0.0

LOG_LEVEL=info
LOG_PRETTY=false

# Optional rotating file sink (leave unset to log to stdout only,
# which is the recommended setup when a log shipper is present)
# LOG_DIR=/var/log/orderbari
LOG_FILE_NAME=app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_FILES=14

# Extra comma-separated redact paths on top of the built-in defaults
# LOG_REDACT_PATHS=customer.phone,*.nid
