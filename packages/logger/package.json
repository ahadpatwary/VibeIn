{
   "name": "@app/logger",
   "description": "Production-ready, Pino-backed, swappable structured logger",
   "version": "1.0.0",
   "dependencies": {
      "@app/eslint-config": "1.0.0",
      "pino": "^9.4.0",
      "pino-roll": "^2.2.0",
      "reflect-metadata": "^0.2.2",
      "tsyringe": "^4.10.0",
      "zod": "^4.6.4"
   },
   "devDependencies": {
      "@types/node": "^24.0.0",
      "pino-pretty": "^11.2.2",
      "typescript": "^5.9.0"
   },
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js",
         "require": "./dist/index.cjs"
      }
   },
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "peerDependencies": {},
   "private": true,
   "scripts": {
      "build": "tsup",
      "dev": "tsup --watch",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "typecheck": "tsc --noEmit",
      "clean": "rimraf dist",
      "prepublishOnly": "npm run clean && npm run build"
   },
   "type": "module",
   "types": "./dist/index.d.ts"
}
