{
   "name": "@app/rate-limiter",
   "description": "Type-safe ioredis wrapper with custom domain methods",
   "version": "0.1.0",
   "dependencies": {
      "@app/logger": "1.0.0",
      "@app/redis-client": "0.1.0",
      "reflect-metadata": "^0.2.2",
      "tsyringe": "^4.10.0",
      "zod": "^4.6.4"
   },
   "devDependencies": {
      "@app/eslint-config": "1.0.0",
      "@types/node": "^24.0.0",
      "tsup": "^8.0.0",
      "typescript": "^5.9.0"
   },
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js",
         "require": "./dist/index.cjs"
      }
   },
   "files": [
      "dist"
   ],
   "keywords": [
      "rate-limiter",
      "typescript"
   ],
   "license": "MIT",
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "peerDependencies": {},
   "private": true,
   "scripts": {
      "build": "tsup && node ./scripts/copy-lua.js",
      "dev": "tsup --watch",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "typecheck": "tsc --noEmit",
      "clean": "rimraf dist",
      "prepublishOnly": "npm run clean && npm run build"
   },
   "sideEffects": false,
   "type": "module",
   "types": "./dist/index.d.ts"
}
