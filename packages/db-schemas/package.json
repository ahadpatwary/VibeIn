{
   "name": "@app/db-schemas",
   "version": "1.0.0",
   "private": true,
   "type": "module",
   "description": "Shared, connection-agnostic Mongoose schemas + repositories for Orderbari/TrustLoop, built on @app/mongo",
   "main": "./dist/index.js",
   "module": "./dist/index.mjs",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.mjs",
         "require": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "tsup",
      "dev": "tsup --watch",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "typecheck": "tsc --noEmit",
      "clean": "rimraf dist",
      "prepublishOnly": "npm run clean && npm run build"
   },
   "dependencies": {
      "@app/logger": "^1.0.0",
      "mongoose": "^8.6.0",
      "reflect-metadata": "^0.2.2",
      "tsyringe": "^4.8.0",
      "uuid": "^14.0.2",
      "zod": "^4.4.3"
   },
   "peerDependencies": {},
   "devDependencies": {
      "@app/eslint-config": "*",
      "@types/node": "^22.10.7",
      "typescript": "^5.7.3"
   }
}
