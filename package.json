{
  "name": "soundfear",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for VibeIn (workspaces)",
  "homepage": "https://github.com/ahadpatwary/VibeIn#readme",
  "bugs": {
    "url": "https://github.com/ahadpatwary/VibeIn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahadpatwary/VibeIn.git"
  },
  "license": "ISC",
  "author": "Abdul Ahad Patwary",
  "packageManager": "npm@9",
  "workspaces": [
    "apps/*",
    "apps/services/*",
    "apps/web/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prune:deps": "node ./scripts/prune-deps.js",
    "dev": "tsx watch packages/rate-limiter/src/container/container.ts"
  },
  "devDependencies": {
    "depcheck": "^1.4.2",
    "tsx": "^4.23.13"
  }
}
